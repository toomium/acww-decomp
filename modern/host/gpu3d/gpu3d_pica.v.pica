; The 3DS's vertex shader for the own 3D engine's polygons (gpu3d_pica.c): the geometry engine has transformed,
; lit and clipped them already, so the vertices only pass through.

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc0 v2

.proc main
	mov outpos, inpos
	mov outclr, inclr
	mov outtc0, intc0
	end
.end
